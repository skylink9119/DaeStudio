{
  "global": {
    "wanInterface": "auto",
    "lanInterfaces": [
      "br-lan"
    ],
    "dialMode": "domain+",
    "logLevel": "warn",
    "tproxyPort": 12345,
    "tproxyPortProtect": true,
    "soMarkFromDae": 0,
    "allowInsecure": false,
    "autoConfigKernelParameter": true,
    "checkInterval": "30s",
    "checkTolerance": "50ms",
    "tcpCheckUrl": "http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111",
    "tcpCheckHttpMethod": "HEAD",
    "udpCheckDns": "dns.google:53,8.8.8.8,2001:4860:4860::8888",
    "sniffingTimeout": "100ms",
    "tlsImplementation": "utls",
    "utlsImitate": "chrome_auto",
    "mptcp": false,
    "disableWaitingNetwork": false
  },
  "dns": {
    "mode": "visual",
    "bind": "127.0.0.1:15353",
    "ipVersionPrefer": 4,
    "upstreams": [
      {
        "tag": "alidns",
        "url": "udp://223.5.5.5:53",
        "note": "阿里公共 UDP DNS（国内毫秒级直连解析）"
      },
      {
        "tag": "cfdns",
        "url": "tcp://1.1.1.1:53",
        "note": "Cloudflare 海外无污染 TCP DNS（经代理隧道加密查询）"
      }
    ],
    "requestRules": [
      {
        "id": "default-dns-1",
        "enabled": true,
        "expr": "qname(geosite:private)",
        "target": "alidns",
        "comment": "局域网与私有域名直连解析"
      },
      {
        "id": "default-dns-2",
        "enabled": false,
        "expr": "qname(geosite:category-ads-all)",
        "target": "reject",
        "comment": "广告与追踪域名拦截（按需开启）"
      },
      {
        "id": "default-dns-3",
        "enabled": true,
        "expr": "qname(suffix:googleapis.cn, suffix:xn--ngstr-lra8j.com)",
        "target": "cfdns",
        "comment": "Google CN 特例域名走海外无污染解析"
      },
      {
        "id": "default-dns-4",
        "enabled": true,
        "expr": "qname(geosite:cn)",
        "target": "alidns",
        "comment": "国内网站与 App 域名直连解析（含 Apple/微软/Steam 国内 CDN）"
      }
    ],
    "requestFallback": "cfdns",
    "responseRules": null,
    "responseFallback": "accept",
    "rawDsl": ""
  },
  "routing": {
    "mode": "visual",
    "rules": [
      {
        "id": "default-route-1",
        "enabled": true,
        "name": "系统网络与拨号校时进程强制直连",
        "category": "system",
        "conditions": [
          {
            "negate": false,
            "field": "pname",
            "value": "NetworkManager, netifd, odhcp6c, pppd, ntpd, chronyd"
          }
        ],
        "outbound": "must_direct"
      },
      {
        "id": "default-route-2",
        "enabled": true,
        "name": "NTP 时间同步直连",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "l4proto",
            "value": "udp"
          },
          {
            "negate": false,
            "field": "dport",
            "value": "123"
          }
        ],
        "outbound": "must_direct"
      },
      {
        "id": "default-route-3",
        "enabled": true,
        "name": "局域网、私有网段与组播广播直连",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "dip",
            "value": "geoip:private, 224.0.0.0/3, 'ff00::/8'"
          }
        ],
        "outbound": "direct"
      },
      {
        "id": "default-route-4",
        "enabled": true,
        "name": "局域网私有域名直连",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "geosite:private"
          }
        ],
        "outbound": "direct"
      },
      {
        "id": "default-route-5",
        "enabled": false,
        "name": "广告连接拦截（按需开启）",
        "category": "block",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "geosite:category-ads-all"
          }
        ],
        "outbound": "block"
      },
      {
        "id": "default-route-6",
        "enabled": true,
        "name": "Google CN 与安卓推送服务优先走代理",
        "category": "custom",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "suffix:googleapis.cn, suffix:xn--ngstr-lra8j.com, full:mtalk.google.com, full:alt1-mtalk.google.com, full:alt2-mtalk.google.com"
          }
        ],
        "outbound": "proxy"
      },
      {
        "id": "default-route-7",
        "enabled": true,
        "name": "国际流媒体走流媒体策略组",
        "category": "media",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "suffix:youtube.com, suffix:youtu.be, suffix:googlevideo.com, suffix:ytimg.com, suffix:youtubei.googleapis.com, suffix:netflix.com, suffix:nflxvideo.net, suffix:disneyplus.com, suffix:spotify.com"
          }
        ],
        "outbound": "streaming"
      },
      {
        "id": "default-route-8",
        "enabled": true,
        "name": "国内网站与 App 域名直连（含 Apple / 微软 / Steam 国内 CDN）",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "geosite:cn"
          }
        ],
        "outbound": "direct"
      },
      {
        "id": "default-route-9",
        "enabled": true,
        "name": "海外知名网站与国际 App 域名优先代理（防污染缓存 IP 误直连）",
        "category": "custom",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "geosite:geolocation-!cn"
          }
        ],
        "outbound": "proxy"
      },
      {
        "id": "default-route-10",
        "enabled": true,
        "name": "国内目标 IP 直连（兜底微信通话 / 国内手游 / 纯 IP 流量）",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "dip",
            "value": "geoip:cn"
          }
        ],
        "outbound": "direct"
      }
    ],
    "fallback": "proxy",
    "rawDsl": ""
  },
  "version": "1.0.0",
  "auth": {
    "enabled": false,
    "username": "admin"
  },
  "subscriptions": [],
  "nodes": [],
  "snapshots": [],
  "directWithoutNodes": true,
  "groups": [
    {
      "id": "grp-proxy",
      "name": "proxy",
      "description": "自动选择可用节点",
      "enabled": true,
      "policy": "min_moving_avg",
      "mode": "smart",
      "filter": {}
    },
    {
      "id": "grp-streaming",
      "name": "streaming",
      "description": "流媒体自动选路，可单独指定出口",
      "enabled": true,
      "policy": "min_moving_avg",
      "mode": "smart",
      "filter": {}
    }
  ]
}
