{
  "global": {
    "wanInterface": "auto",
    "lanInterfaces": [
      "br-lan"
    ],
    "dialMode": "domain++",
    "logLevel": "warn",
    "tproxyPort": 12345,
    "tproxyPortProtect": true,
    "soMarkFromDae": 0,
    "allowInsecure": false,
    "autoConfigKernelParameter": true,
    "checkInterval": "60s",
    "checkTolerance": "50ms",
    "tcpCheckUrl": "http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111",
    "tcpCheckHttpMethod": "HEAD",
    "udpCheckDns": "dns.google:53,8.8.8.8,2001:4860:4860::8888",
    "sniffingTimeout": "100ms",
    "tlsImplementation": "utls",
    "utlsImitate": "chrome_auto",
    "mptcp": false,
    "disableWaitingNetwork": false
  },
  "dns": {
    "mode": "visual",
    "bind": "127.0.0.1:15353",
    "ipVersionPrefer": 4,
    "upstreams": [
      {
        "tag": "alidns",
        "url": "udp://223.5.5.5:53",
        "note": "阿里公共 UDP DNS（国内毫秒级直连解析）"
      },
      {
        "tag": "cfdns",
        "url": "tcp://1.1.1.1:53",
        "note": "Cloudflare 海外无污染 TCP DNS（经代理隧道加密查询，免二次 TLS 握手）"
      }
    ],
    "requestRules": [
      {
        "id": "opt-dns-private",
        "enabled": true,
        "expr": "qname(geosite:private)",
        "target": "alidns",
        "comment": "局域网与私有域名不走代理隧道"
      },
      {
        "id": "opt-dns-google-cn",
        "enabled": true,
        "expr": "qname(suffix:googleapis.cn, suffix:xn--ngstr-lra8j.com)",
        "target": "cfdns",
        "comment": "Google CN 特例域名走海外无污染解析（优先于 geosite:cn）"
      },
      {
        "id": "opt-dns-cn",
        "enabled": true,
        "expr": "qname(geosite:cn)",
        "target": "alidns",
        "comment": "国内网站与 App 域名直连解析（已含 Apple/微软/Steam 国内 CDN）"
      }
    ],
    "requestFallback": "cfdns",
    "responseRules": null,
    "responseFallback": "accept",
    "rawDsl": ""
  },
  "routing": {
    "mode": "visual",
    "rules": [
      {
        "id": "opt-rt-1",
        "enabled": true,
        "name": "系统网络核心进程强制直连（防回环）",
        "category": "system",
        "conditions": [
          {
            "negate": false,
            "field": "pname",
            "value": "NetworkManager, systemd-resolved, dnsmasq, netifd, odhcp6c, pppd, ntpd, chronyd"
          }
        ],
        "outbound": "must_direct"
      },
      {
        "id": "opt-rt-2",
        "enabled": true,
        "name": "国内公共 DNS 上游强制直连（免嗅探开销）",
        "category": "system",
        "conditions": [
          {
            "negate": false,
            "field": "dip",
            "value": "223.5.5.5, 223.6.6.6, 119.29.29.29"
          }
        ],
        "outbound": "must_direct"
      },
      {
        "id": "opt-rt-3",
        "enabled": true,
        "name": "NTP 时间同步直连",
        "category": "system",
        "conditions": [
          {
            "negate": false,
            "field": "l4proto",
            "value": "udp"
          },
          {
            "negate": false,
            "field": "dport",
            "value": "123"
          }
        ],
        "outbound": "must_direct"
      },
      {
        "id": "opt-rt-4",
        "enabled": true,
        "name": "局域网、私有网段与组播广播直连",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "dip",
            "value": "geoip:private, 224.0.0.0/3, 'ff00::/8'"
          }
        ],
        "outbound": "direct"
      },
      {
        "id": "opt-rt-5",
        "enabled": true,
        "name": "局域网私有域名直连",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "geosite:private"
          }
        ],
        "outbound": "direct"
      },
      {
        "id": "opt-rt-6",
        "enabled": true,
        "name": "Google CN 与安卓推送服务走代理（优先于国内域名）",
        "category": "custom",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "suffix:googleapis.cn, suffix:xn--ngstr-lra8j.com, full:mtalk.google.com, full:alt1-mtalk.google.com, full:alt2-mtalk.google.com"
          }
        ],
        "outbound": "proxy"
      },
      {
        "id": "opt-rt-7",
        "enabled": true,
        "name": "国内网站与 App 域名直连（含 Apple / 微软 / Steam 国内 CDN）",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "geosite:cn"
          }
        ],
        "outbound": "direct"
      },
      {
        "id": "opt-rt-8",
        "enabled": true,
        "name": "海外知名网站与国际 App 域名优先代理（防污染缓存 IP 误走直连）",
        "category": "custom",
        "conditions": [
          {
            "negate": false,
            "field": "domain",
            "value": "geosite:geolocation-!cn"
          }
        ],
        "outbound": "proxy"
      },
      {
        "id": "opt-rt-9",
        "enabled": true,
        "name": "国内目标 IP 直连（兜底微信通话 / 国内手游 / 纯 IP 流量）",
        "category": "direct",
        "conditions": [
          {
            "negate": false,
            "field": "dip",
            "value": "geoip:cn"
          }
        ],
        "outbound": "direct"
      }
    ],
    "fallback": "proxy",
    "rawDsl": ""
  },
  "version": "1.0.0",
  "auth": {
    "enabled": false,
    "username": "admin"
  },
  "subscriptions": [],
  "nodes": [],
  "snapshots": [],
  "directWithoutNodes": true,
  "groups": [
    {
      "id": "grp-proxy",
      "name": "proxy",
      "description": "自动选择可用节点",
      "enabled": true,
      "policy": "min_moving_avg",
      "mode": "smart",
      "filter": {}
    },
    {
      "id": "grp-streaming",
      "name": "streaming",
      "description": "流媒体自动选路，可单独指定出口",
      "enabled": true,
      "policy": "min_moving_avg",
      "mode": "smart",
      "filter": {}
    }
  ]
}
